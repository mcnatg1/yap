{
  "name": "yap-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check:node": "node ./tests/scripts/assert-node24.mjs",
    "check:dependency-licenses": "pnpm check:node && node ./tests/scripts/shipped-dependency-inventory.mjs",
    "audit:dependencies": "pnpm check:node && node ./tests/scripts/audit-dependencies.mjs",
    "dev": "pnpm check:node && vite",
    "build": "pnpm check:node && tsc && vite build",
    "preview": "pnpm check:node && vite preview",
    "tauri": "pnpm check:node && tauri",
    "test": "pnpm check:node && vitest run",
    "test:release-contract": "pnpm check:node && node --test ./tests/scripts/release-evidence.contract.mjs",
    "test:local": "pnpm check:node && node ./tests/scripts/run-local-only-tests.mjs",
    "test:release-contract:local": "pnpm check:node && node --test ./tests/scripts/release-evidence-local.contract.mjs",
    "test:release-contract:all": "pnpm test:release-contract && pnpm test:release-contract:local",
    "test:e2e": "pnpm check:node && node ./tests/scripts/run-playwright-e2e.mjs",
    "test:e2e:update": "pnpm check:node && node ./tests/scripts/run-playwright-e2e.mjs --update-snapshots",
    "test:desktop": "pnpm check:node && wdio run ./tests/wdio.conf.ts",
    "test:desktop:build": "pnpm check:node && node ./tests/scripts/tauri-wdio-build.mjs",
    "test:desktop:build:release": "pnpm check:node && node ./tests/scripts/tauri-wdio-build.mjs --release",
    "test:desktop:all": "pnpm test:desktop:build && pnpm test:desktop",
    "test:target-client-language-routing-ui": "pnpm check:node && wdio run ./tests/wdio.target-client-language-routing.conf.ts",
    "test:private-server-asr-gate": "pnpm test:desktop:build && pnpm check:node && wdio run ./tests/wdio.private-server-asr-gate.conf.ts",
    "test:nsis:disposable": "pnpm check:node && pwsh.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ./tests/scripts/smoke-nsis.ps1"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@wdio/cli": "^9.30.0",
    "@wdio/local-runner": "^9.30.0",
    "@wdio/mocha-framework": "^9.30.0",
    "@wdio/spec-reporter": "^9.29.1",
    "@wdio/tauri-plugin": "^1.2.0",
    "@wdio/tauri-service": "^1.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "webdriverio": "^9.30.0",
    "yaml": "^2.9.0"
  }
}
